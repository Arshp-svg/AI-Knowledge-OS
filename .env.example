# ========================================================
# AI Knowledge OS - Production Environment Variables
# ========================================================

# 1. Groq Cloud Inference API Key (Required)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Qdrant Vector Database
# Local embedded mode: leave empty (defaults to embedded storage/qdrant_db)
# Docker Compose: http://qdrant:6333
# Qdrant Cloud: https://<cluster-id>.us-east-1.gcp.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# 3. Security & Access Control
ADMIN_API_KEY=demo-admin-key-2026
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 4. OpenTelemetry / Langfuse Tracing (Optional)
# Get free keys at: https://cloud.langfuse.com
# If omitted, system falls back to high-performance local SQLite telemetry
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 5. Frontend Client Configuration
# Public URL where the browser connects to the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
